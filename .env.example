# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (Supabase, Neon, or Cloud SQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/ugegbe_gwr?schema=public"

# RESEND_API_KEY: Transactional email service key for confirmation and QR tickets
RESEND_API_KEY="re_123456789_abcdefg"

# RESEND_FROM_EMAIL: Sender email address verified in your Resend dashboard
RESEND_FROM_EMAIL="tickets@ugegbegwr.com"

# ADMIN_PASSWORD_HASH: Master password or hash for administrative operations portal
ADMIN_PASSWORD="marathon2026"

# NEXTAUTH_SECRET / SESSION_SECRET: 32+ character random string for signing admin session tokens
SESSION_SECRET="ugegbe-marathon-secret-jwt-key-2026-lagos-super-secure"

# NEXT_PUBLIC_PLAUSIBLE_DOMAIN: Optional Plausible privacy-friendly analytics domain
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="ugegbegwr.com"

# NEXT_PUBLIC_EVENT_TIMEZONE: Official timezone for the Guinness World Records attempt
NEXT_PUBLIC_EVENT_TIMEZONE="Africa/Lagos"

